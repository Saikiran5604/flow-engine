# ---------------------------------------------------------------------------
# Data layer selection
# ---------------------------------------------------------------------------
# When BOTH of these are set, the app uses the nhost/Hasura GraphQL adapter
# (lib/data/nhost.ts). When either is missing, it falls back to the in-memory
# store (lib/data/memory.ts) so the demo always runs. See lib/data/index.ts.
NHOST_GRAPHQL_URL=
NHOST_ADMIN_SECRET=

# ---------------------------------------------------------------------------
# LLM provider (llm_call steps)
# ---------------------------------------------------------------------------
# Optional. Without it, llm_call falls back to a clearly-disclosed stub.
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# nhost function <-> Hasura action shared secret (used inside nhost only)
# ---------------------------------------------------------------------------
NHOST_WEBHOOK_SECRET=
